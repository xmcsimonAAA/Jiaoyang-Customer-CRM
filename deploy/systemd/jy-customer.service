[Unit]
Description=Jiaoyang Customer CRM API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=jycrm
Group=jycrm
WorkingDirectory=/opt/jy-customer
EnvironmentFile=/etc/jy-customer/jy-customer.env
ExecStart=/opt/jy-customer/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8011 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/jy-customer

[Install]
WantedBy=multi-user.target
