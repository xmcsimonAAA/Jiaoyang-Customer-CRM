# /etc/jy-customer/jy-customer.env. This file must be mode 0600 and never committed.
DATABASE_URL=postgresql://jy_crm:replace-with-a-long-random-password@127.0.0.1:5432/jy_customer_crm

# Customer module to MuskZoom identity API. Use independent random secrets.
MUSKZOOM_IDENTITY_URL=https://muskzoom.com/api/integrations/customer-crm/users
MUSKZOOM_IDENTITY_SECRET=replace-with-a-long-random-service-secret
MUSKZOOM_SSO_SECRET=replace-with-a-different-long-random-sso-secret
MUSKZOOM_SSO_AUDIENCE=jiaoyang-customer-crm
MUSKZOOM_SSO_ISSUER=muskzoom
MUSKZOOM_SSO_REQUIRE_STRONG_CLAIMS=true
MUSKZOOM_SSO_TTL_SECONDS=90

# Cookie policy for the HTTPS-only crm.muskzoom.com service.
CRM_SESSION_COOKIE=jy_crm_session
CRM_COOKIE_SECURE=true
CRM_ALLOW_PASSWORD_LOGIN=false
MUSKZOOM_ENTRY_URL=https://muskzoom.com
